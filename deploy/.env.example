# 复制为 .env 后按实际值修改（cp .env.example .env && chmod 600 .env）
# 该文件同时被 docker compose 用于变量替换，以及 api 容器的运行环境（env_file）

# ---------- 编排参数 ----------
# 数据落盘根目录：MySQL 数据与本地存储都放在这里（系统盘 40G，注意定期清理镜像）
DATA_DIR=/srv/wechat
# 镜像地址：推送到 ACR 后改成真实地址；仅本地构建可保持默认
IMAGE=wechat-markup-api:latest
# MySQL 镜像：ECS 拉不到 Docker Hub 时，把 mysql:5.7 推到 ACR 后改成 ACR 地址
MYSQL_IMAGE=mysql:5.7
TZ=Asia/Shanghai

# MySQL root 密码：只允许字母数字，避免连接串转义问题
DB_ROOT_PASSWORD=change-me-root-pwd
DB_NAME=wechat_markup

# ---------- 服务端 ----------
NODE_ENV=production
PORT=3000

# 容器内用服务名 db 访问 MySQL；connection_limit 限制 Prisma 连接池，避免打满 2G 机器
DATABASE_URL=mysql://root:change-me-root-pwd@db:3306/wechat_markup?connection_limit=5&pool_timeout=10

# 未部署 Redis 时保持默认即可：连接失败会自动降级，不阻塞启动
REDIS_URL=redis://127.0.0.1:6379/0

# 生产必须替换：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=please-replace-with-32-bytes-random
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# 允许跨域来源：admin 与 API 同域时留实际域名，多个用英文逗号分隔
CORS_ORIGINS=https://your.domain

# ---------- 微信小程序 ----------
WX_APPID=
WX_SECRET=
WX_TEMPLATE_INVITATION=
WX_TEMPLATE_RESULT=

# ---------- 对象存储（四个变量齐全即切换为 OSS，读取走 OSS 直连签名地址） ----------
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ---------- 本地存储（未配置 OSS 时生效） ----------
STORAGE_DIR=storage
STORAGE_SECRET=
MAX_UPLOAD_MB=5

# 身份证等敏感字段 AES 密钥，32 位十六进制
AES_KEY=
