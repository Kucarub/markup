/**
 * 设计 token：来源 figmaDesign（375px 设计稿），与 admin/src/styles/tokens.scss 同名同值。
 * 小程序换算：1px = 2rpx。
 */
page {
  /* 品牌色（豆沙玫瑰） */
  --color-primary: #b4566e;
  --color-primary-light: #c96d84;
  --color-primary-dark: #96465b;
  --color-primary-tint: #f7e7ec;
  --color-primary-soft: #fcf5f7;

  /* 语义色 */
  --color-success: #2fa36b;
  --color-warning: #e39a2b;
  --color-danger: #d9483b;
  --color-info: #3b7fd9;

  /* 文本 */
  --color-text-primary: #1a1a1a;
  --color-text-secondary: #8c8c8c;
  --color-text-regular: #4a4a4a;
  --color-text-placeholder: #bfbfbf;
  --color-text-inverse: #ffffff;

  /* 背景与描边（内容区纯白 + 加深灰面，保证卡片与日期格可辨） */
  --color-bg-page: #ffffff;
  --color-bg-card: #ffffff;
  --color-bg-muted: #eeeeee;
  --color-border: #dedede;
  --color-divider: #f0f0f0;

  /* 字号（设计 px × 2 = rpx） */
  --font-size-xs: 24rpx;
  --font-size-sm: 28rpx;
  --font-size-md: 32rpx;
  --font-size-lg: 36rpx;
  --font-size-xl: 44rpx;
  --font-size-xxl: 56rpx;

  /* 间距（4pt 体系） */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 32rpx;
  --space-lg: 48rpx;
  --space-xl: 64rpx;

  /* 圆角 */
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-pill: 999rpx;

  /* 阴影 */
  --shadow-card: 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
  --shadow-float: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);

  /* 字体栈 */
  --font-family-base: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'HarmonyOS Sans SC',
    'Microsoft YaHei', sans-serif;

  background-color: var(--color-bg-page);
  color: var(--color-text-primary);
  font-family: var(--font-family-base);
  font-size: var(--font-size-sm);
  -webkit-font-smoothing: antialiased;
}
