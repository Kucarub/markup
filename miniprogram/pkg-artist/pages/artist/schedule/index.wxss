.schedule-page {
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.schedule-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: var(--space-md);
}

.batch-toggle {
  min-height: 56rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid var(--color-primary-tint);
  border-radius: var(--radius-pill);
  color: var(--color-primary);
  font-size: var(--font-size-xs);
  font-weight: 600;
}

.schedule-empty__action {
  margin-top: var(--space-md);
}

.schedule-loading {
  color: var(--color-text-placeholder);
  font-size: var(--font-size-sm);
  text-align: center;
  padding: var(--space-xl) var(--space-md);
}

/* ---------- 批量设置 ---------- */
.batch-panel__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.batch-panel__hint {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
}

.batch-row {
  margin-top: var(--space-md);
}

.batch-row__label {
  display: block;
  margin-bottom: var(--space-xs);
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
}

.batch-range {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.batch-range__value {
  min-width: 200rpx;
  height: 72rpx;
  padding: 0 var(--space-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
}

.batch-range__sep {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
}

.batch-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  min-width: 64rpx;
  height: 60rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-pill);
  background: var(--color-bg-card);
  color: var(--color-text-regular);
  font-size: var(--font-size-xs);
}

.chip--active {
  border-color: var(--color-primary);
  background: var(--color-primary-tint);
  color: var(--color-primary);
  font-weight: 600;
}

.batch-submit {
  margin-top: var(--space-lg);
}

.batch-panel__tip {
  margin-top: var(--space-xs);
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
  text-align: center;
}

/* ---------- 汇总 ---------- */
.schedule-summary {
  display: flex;
  gap: var(--space-sm);
  margin-bottom: var(--space-sm);
}

.summary-item {
  flex: 1;
  padding: var(--space-sm) 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-bg-card);
}

.summary-item__value {
  font-size: var(--font-size-lg);
  font-weight: 650;
  line-height: 1;
}

.summary-item__value--available {
  color: var(--color-success);
}

.summary-item__value--booked {
  color: #bd7200;
}

.summary-item__value--rest {
  color: var(--color-text-secondary);
}

.summary-item__label {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

/* ---------- 月历 ---------- */
.calendar__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-sm);
}

.calendar__title {
  font-size: var(--font-size-md);
  font-weight: 650;
}

.calendar__nav {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 36rpx;
  line-height: 1;
}

.calendar__nav--disabled {
  background: var(--color-bg-muted);
  color: var(--color-text-placeholder);
}

.calendar__week {
  display: flex;
  padding-bottom: var(--space-xs);
  border-bottom: 2rpx solid var(--color-divider);
}

.calendar__week-item {
  width: 14.28%;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.calendar__grid {
  display: flex;
  flex-wrap: wrap;
  padding-top: var(--space-xs);
}

.day {
  position: relative;
  width: 14.28%;
  height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  border-radius: var(--radius-sm);
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
}

.day--blank {
  pointer-events: none;
}

.day__num {
  line-height: 1;
}

.day__dot {
  width: 8rpx;
  height: 8rpx;
  margin-top: 8rpx;
  border-radius: 50%;
  background: transparent;
}

.day--available {
  background: #e7f6ef;
  color: #1f7a4d;
}

.day--available .day__dot {
  background: var(--color-success);
}

.day--booked {
  background: #fff3dd;
  color: #a35f00;
}

.day--booked .day__dot {
  background: var(--color-warning);
}

.day--rest {
  background: var(--color-bg-muted);
  color: var(--color-text-secondary);
}

.day--rest .day__dot {
  background: var(--color-text-placeholder);
}

.day--none {
  border-color: var(--color-divider);
  color: var(--color-text-secondary);
}

.day--today {
  border-color: var(--color-primary);
  font-weight: 700;
}

.day--past {
  opacity: 0.4;
}

.calendar__legend {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-top: var(--space-md);
  padding-top: var(--space-sm);
  border-top: 2rpx solid var(--color-divider);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.legend-dot--available {
  background: var(--color-success);
}

.legend-dot--booked {
  background: var(--color-warning);
}

.legend-dot--rest {
  background: var(--color-text-placeholder);
}

.legend-dot--none {
  border: 2rpx solid var(--color-border);
}

.schedule-tip {
  margin-top: var(--space-sm);
  padding: 0 var(--space-xs);
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
  line-height: 1.7;
}
