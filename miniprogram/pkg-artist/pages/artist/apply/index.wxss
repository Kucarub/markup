/* 化妆师入驻表单：字段、作品九宫格、协议与底部提交（E4-01 / E4-04） */
.apply {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.apply__card {
  margin-top: 32rpx;
}

/* 分组标题 */
.form-section {
  margin: 40rpx 0 0;
  padding-top: 32rpx;
  border-top: 2rpx solid var(--color-divider);
  font-size: 30rpx;
  font-weight: 650;
}

.form-section--first {
  margin-top: 0;
  padding-top: 0;
  border-top: none;
}

/* 审核状态提示 */
.notice {
  margin-top: 32rpx;
  padding: 24rpx 28rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-primary-soft);
}

.notice--approved {
  border-color: #bfe6d2;
  background: #e7f6ef;
}

.notice--rejected {
  border-color: #f3cfcb;
  background: #fcecea;
}

.notice--pending {
  border-color: #f3ddb5;
  background: #fff3dd;
}

.notice__title {
  font-size: 28rpx;
  font-weight: 650;
  color: var(--color-primary);
}

.notice--approved .notice__title {
  color: var(--color-success);
}

.notice--rejected .notice__title {
  color: var(--color-danger);
}

.notice--pending .notice__title {
  color: #bd7200;
}

.notice__desc {
  margin-top: 8rpx;
  color: var(--color-text-regular);
  font-size: 24rpx;
  line-height: 1.6;
}

/* 字段 */
.field {
  margin-top: 30rpx;
}

.field__label {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  color: var(--color-text-regular);
  font-size: 26rpx;
  font-weight: 600;
}

.field__required {
  margin-left: 4rpx;
  color: var(--color-danger);
  font-size: 24rpx;
  line-height: 1;
}

.field__label-note {
  margin-left: auto;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  font-weight: 400;
}

.field__hint {
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 1.6;
}

.field__error {
  margin-top: 8rpx;
  color: var(--color-danger);
  font-size: 22rpx;
  line-height: 1.5;
}

.field__counter {
  margin-top: 6rpx;
  color: var(--color-text-placeholder);
  font-size: 22rpx;
  text-align: right;
}

/* 城市选择 */
.field__picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field__picker-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.field__picker-text.is-placeholder {
  color: var(--color-text-placeholder);
}

/* 风格标签 */
.styles {
  display: flex;
  flex-wrap: wrap;
}

.style-chip {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  margin: 0 12rpx 12rpx 0;
  padding: 0 28rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-pill);
  background: var(--color-bg-card);
  color: var(--color-text-regular);
  font-size: 26rpx;
  transition:
    border-color 0.16s,
    background 0.16s,
    color 0.16s;
}

.style-chip--on {
  border-color: var(--color-primary);
  background: var(--color-primary-tint);
  color: var(--color-primary);
  font-weight: 600;
}

/* 作品九宫格 */
.works {
  display: flex;
  flex-wrap: wrap;
  margin-top: 4rpx;
  margin-right: -10rpx;
}

.work {
  position: relative;
  width: calc((100% - 20rpx) / 3);
  height: 200rpx;
  margin: 16rpx 10rpx 0 0;
  overflow: hidden;
  border-radius: 16rpx;
  background: var(--color-bg-muted);
}

.work__media {
  display: block;
  width: 100%;
  height: 100%;
}

.work__media--empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.work__media--video {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #444 0%, #1a1a1a 100%);
}

.work__play {
  width: 0;
  height: 0;
  margin-left: 8rpx;
  border-top: 18rpx solid transparent;
  border-bottom: 18rpx solid transparent;
  border-left: 30rpx solid rgba(255, 255, 255, 0.92);
}

.work__type {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 20rpx;
}

.work__mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
  color: #ffffff;
  font-size: 22rpx;
}

.work__remove {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-bottom-left-radius: 16rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  font-size: 28rpx;
  line-height: 1;
}

.work--add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--color-border);
  background: #fafafa;
}

.work--add:active {
  background: var(--color-primary-soft);
}

.work__add-text {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 20rpx;
}

/* 协议 */
.apply__agreement {
  margin-top: 16rpx;
  padding: 28rpx 32rpx;
}

.agreement {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.agreement__box {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 32rpx;
  height: 32rpx;
  margin-top: 4rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--color-text-placeholder);
  border-radius: 8rpx;
  background: #ffffff;
}

.agreement__box--on {
  border-color: var(--color-primary);
  background: var(--color-primary);
}

.agreement__tick {
  width: 9rpx;
  height: 16rpx;
  margin-top: -3rpx;
  border-right: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  transform: rotate(45deg);
}

.agreement__text {
  flex: 1;
}

.agreement__link {
  color: var(--color-info);
}

/* 底部提交 */
.apply__footer {
  position: fixed;
  z-index: 5;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.apply__submit {
  height: 96rpx;
  border-radius: 18rpx;
  font-size: 30rpx;
  box-shadow: 0 14rpx 32rpx rgba(180, 86, 110, 0.18);
}
