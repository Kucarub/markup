/* 化妆师接单中心（E9-04 / E9-05 / E9-06）：定向预约处理与服务记录 */
.inbox {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.inbox__head {
  padding: var(--space-md) var(--space-md) 0;
}

.inbox__sub {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

/* 状态 Tab 使用全局分段式控件（styles/segmented-tabs.wxss） */

/* ---------- 状态卡片 ---------- */
.inbox__notice {
  margin: var(--space-md);
}

.inbox__notice-btn {
  margin-top: var(--space-sm);
}

.inbox__body {
  padding: var(--space-sm) var(--space-md) var(--space-md);
}

.inbox-card {
  margin-top: var(--space-sm);
  padding: 28rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
  box-shadow: var(--shadow-card);
}

.inbox-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.inbox-card__date {
  color: var(--color-primary);
  font-size: 28rpx;
  font-weight: 650;
}

.inbox-card__title {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.inbox-card__meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.inbox-card__dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--color-border);
}

.inbox-card__budget {
  color: var(--color-text-regular);
  font-weight: 600;
}

.inbox-card__styles {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.inbox-card__remark {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg-muted, #f7f7f8);
  color: var(--color-text-regular);
  font-size: 24rpx;
  line-height: 1.6;
}

.inbox-card__customer {
  margin-top: 16rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.inbox-card__actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 24rpx;
}
