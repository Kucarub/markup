<view class="screen screen--with-tab">
  <view class="hall-top">
    <view class="page-title-row">
      <view>
        <text class="kicker">OPPORTUNITIES</text>
        <view class="page-heading">需求大厅</view>
      </view>
    </view>
    <view class="hall-sub">同城客户发布的妆造需求，响应后等待客户确认</view>

    <view class="search-field">
      <image class="icon icon--sm" src="/assets/icons/search.svg" mode="aspectFit" />
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="搜索区域 / 备注关键词"
        placeholder-class="input-placeholder"
        confirm-type="search"
        bindinput="onQueryInput"
      />
      <view wx:if="{{keyword}}" class="search-clear" bindtap="onClearQuery">×</view>
    </view>

    <scroll-view class="filter-strip" scroll-x show-scrollbar="{{false}}">
      <view
        wx:for="{{serviceTypes}}"
        wx:key="code"
        class="filter-pill {{activeType === item.code ? 'filter-pill--selected' : ''}}"
        data-code="{{item.code}}"
        bindtap="onTypeTap"
      >{{item.label}}</view>
    </scroll-view>
  </view>

  <view class="hall-content">
    <view class="result-count">
      <text>共 {{total}} 条待响应需求</text>
      <text wx:if="{{keyword}}" class="result-count__tag">筛选出 {{visibleList.length}} 条</text>
    </view>

    <view wx:if="{{loading}}" class="empty">加载中…</view>

    <view wx:elif="{{error}}" class="empty">{{error}}</view>

    <block wx:elif="{{visibleList.length}}">
      <view class="card-list">
        <view class="card-item" wx:for="{{visibleList}}" wx:key="id">
          <demand-card demand="{{item}}" bind:open="onDemandOpen" />
        </view>
      </view>
      <view wx:if="{{loadingMore}}" class="hall-more">加载中…</view>
      <view wx:elif="{{!hasMore}}" class="hall-more">没有更多需求了</view>
    </block>

    <empty-state
      wx:else
      title="当前筛选下暂无需求"
      description="放宽筛选条件，或稍后再来看看"
      action="重置筛选"
      bind:action="onResetFilter"
    />
  </view>
</view>
