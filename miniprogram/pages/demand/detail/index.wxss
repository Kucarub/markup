.detail-page {
  min-height: 100vh;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--color-bg-page);
}

/* ---------- 顶部概要 ---------- */
.detail-hero {
  padding: 44rpx 36rpx 40rpx;
  border-bottom: 2rpx solid var(--color-border);
  background: var(--color-bg-card);
}

.detail-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
  color: var(--color-warning);
  font-size: 22rpx;
}

.hero-deadline {
  color: var(--color-text-secondary);
}

.detail-title {
  margin-bottom: 20rpx;
  font-size: 44rpx;
  font-weight: 650;
  line-height: 1.38;
  letter-spacing: -1rpx;
}

.hero-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--color-text-regular);
  font-size: 24rpx;
}

.hero-tag {
  margin-left: 8rpx;
}

.detail-pay {
  margin-top: 34rpx;
  color: var(--color-primary);
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
}

.detail-pay__unit {
  margin-right: 4rpx;
  font-size: 30rpx;
}

.detail-pay__suffix {
  margin-left: 12rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  font-weight: 500;
}

/* ---------- 分块 ---------- */
.detail-section {
  margin-top: 20rpx;
  padding: 40rpx 36rpx;
  border-top: 2rpx solid var(--color-border);
  border-bottom: 2rpx solid var(--color-border);
  background: var(--color-bg-card);
}

.detail-section-title {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 34rpx;
}

.detail-section-no {
  color: var(--color-primary-light);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.detail-section-name {
  font-size: 32rpx;
  font-weight: 650;
}

/* ---------- 需求信息 ---------- */
.facts-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 36rpx 28rpx;
  padding-bottom: 30rpx;
}

.fact {
  width: calc(50% - 14rpx);
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.fact-icon {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.fact-icon--text {
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 700;
}

.fact-copy {
  min-width: 0;
}

.fact-label {
  color: var(--color-text-secondary);
  font-size: 18rpx;
}

.fact-value {
  margin-top: 4rpx;
  overflow: hidden;
  font-size: 22rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.customer-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--color-divider);
}

.customer-logo {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-primary-tint);
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 700;
}

.customer-copy {
  flex: 1;
  min-width: 0;
}

.customer-label {
  color: var(--color-text-secondary);
  font-size: 18rpx;
}

.customer-value {
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.customer-cities {
  flex: 0 0 auto;
  color: var(--color-text-secondary);
  font-size: 20rpx;
}

/* ---------- 需求说明 ---------- */
.style-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.requirements {
  display: -webkit-box;
  overflow: hidden;
  color: var(--color-text-regular);
  font-size: 26rpx;
  line-height: 1.85;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.requirements--expanded {
  display: block;
}

.expand-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-top: 18rpx;
  color: var(--color-primary);
  font-size: 22rpx;
}

/* ---------- 婉拒反馈与备选（E9-06） ---------- */
.detail-section-title--sub {
  margin-top: 40rpx;
  margin-bottom: 24rpx;
}

.detail-section-title--sub .detail-section-name {
  font-size: 28rpx;
}

.decline-card {
  padding: 26rpx;
  border: 2rpx solid #f2d6de;
  border-radius: var(--radius-md);
  background: var(--color-primary-soft);
}

.decline-card__title {
  font-size: 28rpx;
  font-weight: 650;
}

.decline-card__reason {
  margin-top: 14rpx;
  color: var(--color-text-regular);
  font-size: 24rpx;
  line-height: 1.6;
}

.decline-card__hint {
  margin-top: 14rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

/* ---------- 响应者列表 ---------- */
.response-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.response-card {
  padding: 26rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
}

.response-top {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.avatar__img--text {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-primary);
  font-size: 28rpx;
  font-weight: 700;
}

.response-info {
  flex: 1;
  min-width: 0;
}

.response-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.response-name {
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.response-meta {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 20rpx;
}

.response-styles {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.response-note {
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-sm);
  background: var(--color-primary-soft);
  color: var(--color-text-regular);
  font-size: 22rpx;
  line-height: 1.6;
}

.response-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.response-avail {
  color: var(--color-text-secondary);
  font-size: 20rpx;
}

.response-selected {
  color: var(--color-success);
  font-size: 22rpx;
  font-weight: 600;
}

/* ---------- 我的响应 ---------- */
.my-response {
  margin: 20rpx 24rpx 0;
  padding: 30rpx;
  border: 2rpx solid #f2d6de;
  border-radius: var(--radius-md);
  background: var(--color-primary-soft);
}

.my-response__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.my-response__label {
  font-size: 26rpx;
  font-weight: 650;
}

.my-response__note {
  margin-top: 16rpx;
  color: var(--color-text-regular);
  font-size: 22rpx;
  line-height: 1.6;
}

.my-response__hint {
  margin-top: 16rpx;
  color: var(--color-text-secondary);
  font-size: 20rpx;
  line-height: 1.6;
}

/* ---------- 底部操作栏 ---------- */
.detail-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  padding: 18rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--color-border);
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.detail-action-bar .btn {
  flex: 1;
  height: 96rpx;
}
