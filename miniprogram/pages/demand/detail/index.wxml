<view wx:if="{{demand}}" class="detail-page">
  <view class="detail-hero">
    <view class="detail-label-row">
      <view class="tag tag--{{demand.statusTone}}">{{demand.status}}</view>
      <text>{{demand.deadline}}</text>
    </view>
    <view class="detail-title">{{demand.title}}</view>
    <view class="merchant-row">
      <view class="merchant-logo">云</view>
      <text>{{demand.merchant}}</text>
      <image class="icon icon--xs merchant-check" src="/assets/icons/check-info.svg" mode="aspectFit" />
      <text class="merchant-verified">已认证</text>
    </view>
    <view class="detail-pay">
      <text class="detail-pay__unit">¥</text>
      <text>{{demand.pay}}</text>
      <text class="detail-pay__suffix">/{{demand.payUnit}} · {{demand.duration}}</text>
    </view>
  </view>

  <view class="detail-section">
    <view class="detail-section-title">
      <text class="detail-section-no">01</text>
      <text class="detail-section-name">需求信息</text>
    </view>

    <view class="facts-grid">
      <view class="fact">
        <view class="fact-icon">
          <image class="icon icon--sm" src="/assets/icons/calendar.svg" mode="aspectFit" />
        </view>
        <view class="fact-copy">
          <view class="fact-label">服务日期</view>
          <view class="fact-value">{{demand.dateFull}}</view>
        </view>
      </view>
      <view class="fact">
        <view class="fact-icon">
          <image class="icon icon--sm" src="/assets/icons/clock.svg" mode="aspectFit" />
        </view>
        <view class="fact-copy">
          <view class="fact-label">服务时段</view>
          <view class="fact-value">{{demand.time}}</view>
        </view>
      </view>
      <view class="fact">
        <view class="fact-icon">
          <image class="icon icon--sm" src="/assets/icons/users.svg" mode="aspectFit" />
        </view>
        <view class="fact-copy">
          <view class="fact-label">需求人数</view>
          <view class="fact-value">{{demand.people}} 人</view>
        </view>
      </view>
      <view class="fact">
        <view class="fact-icon fact-icon--text">M</view>
        <view class="fact-copy">
          <view class="fact-label">妆容类型</view>
          <view class="fact-value">{{demand.makeupType}}</view>
        </view>
      </view>
    </view>

    <view class="address-row" bindtap="onNavigate">
      <image class="icon icon--sm address-pin" src="/assets/icons/location.svg" mode="aspectFit" />
      <view class="address-copy">
        <view class="address-label">服务地点</view>
        <view class="address-value">{{demand.address}}</view>
      </view>
      <view class="address-nav">
        <image class="icon icon--xs" src="/assets/icons/nav.svg" mode="aspectFit" />
      </view>
    </view>

    <view class="key-values">
      <view class="key-row">
        <text>化妆箱</text>
        <text class="key-row__value">{{demand.kit}}</text>
      </view>
      <view class="key-row">
        <text>结算方式</text>
        <text class="key-row__value">{{demand.settlement}}</text>
      </view>
    </view>
  </view>

  <view class="detail-section">
    <view class="detail-section-title">
      <text class="detail-section-no">02</text>
      <text class="detail-section-name">商家要求</text>
    </view>
    <view class="requirements {{expanded ? 'requirements--expanded' : ''}}">{{demand.requirements}}</view>
    <view class="expand-btn" bindtap="onToggleExpand">
      <text>{{expanded ? '收起' : '展开全部'}}</text>
      <image
        class="icon icon--xs"
        src="/assets/icons/chevron-{{expanded ? 'up' : 'down'}}.svg"
        mode="aspectFit"
      />
    </view>
  </view>

  <view class="match-card">
    <view class="match-top">
      <view class="match-info">
        <text>与你的匹配度</text>
        <text class="match-value">{{demand.match}}%</text>
      </view>
      <view class="match-ring" style="--match: {{demand.match * 3.6}}deg">
        <text class="match-ring__text">{{demand.match}}</text>
      </view>
    </view>
    <view class="skill-list">
      <view
        wx:for="{{demand.skills}}"
        wx:key="name"
        class="skill {{item.matched ? 'skill--matched' : ''}}"
      >
        <image
          class="icon icon--xs"
          src="/assets/icons/{{item.matched ? 'check' : 'close'}}.svg"
          mode="aspectFit"
        />
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>

  <view class="detail-action-bar">
    <view class="favorite-btn {{isFavorite ? 'favorite-btn--active' : ''}}" bindtap="onToggleFavorite">
      <image
        class="icon icon--md"
        src="/assets/icons/{{isFavorite ? 'heart-fill' : 'heart-gray'}}.svg"
        mode="aspectFit"
      />
      <text>{{isFavorite ? '已收藏' : '收藏'}}</text>
    </view>
    <button class="btn btn--primary" disabled="{{isFull}}" bindtap="onApply">
      {{isFull ? '该需求已招满' : isApplied ? '已投递，查看进度' : '投递作品集'}}
    </button>
  </view>
</view>
