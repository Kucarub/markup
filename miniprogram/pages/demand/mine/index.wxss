/* 我的需求列表（E7-04）：分段式状态 Tab + 需求卡片 + 悬浮发布入口 */
.demand-mine {
  padding-bottom: calc(240rpx + env(safe-area-inset-bottom));
}

.demand-mine__head {
  padding: var(--space-md) var(--space-md) 0;
}

.demand-mine__sub {
  margin-top: var(--space-xs);
  color: var(--color-text-secondary);
  font-size: 21rpx;
  line-height: 1.6;
}

/* 找化妆师入口（E8-05）：分包页不能进 tabBar，由客户落地页进入 */
.demand-mine__search {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 84rpx;
  margin-top: 34rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 2rpx solid #f2e5e9;
  border-radius: 20rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 21rpx;
}

.demand-mine__search text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 状态 Tab 使用全局分段式控件（styles/segmented-tabs.wxss） */

/* 登录 / 角色提示 */
.demand-mine__notice {
  margin: var(--space-md);
}

.demand-mine__notice-btn {
  margin-top: var(--space-md);
}

/* 卡片列表 */
.demand-list {
  padding: 0 var(--space-md);
}

.demand {
  padding: 32rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 26rpx;
  background: var(--color-bg-card);
  box-shadow: 0 4rpx 14rpx rgba(47, 35, 39, 0.05);
}

.demand + .demand {
  margin-top: var(--space-sm);
}

.demand__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.demand__date {
  color: var(--color-text-secondary);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.demand__title {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1.4;
}

.demand__meta {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 20rpx;
  color: var(--color-text-secondary);
  font-size: 20rpx;
}

.demand__meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.demand__meta-icon {
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 auto;
}

.demand__budget {
  color: var(--color-primary);
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}

.demand__styles {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.demand__style {
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  background: #f2f2f2;
  color: var(--color-text-secondary);
  font-size: 18rpx;
  line-height: 1;
}

.demand__remark {
  margin-top: 16rpx;
  color: var(--color-text-regular);
  font-size: 24rpx;
  line-height: 1.6;
}

.demand__foot {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 20rpx;
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--color-border);
}

.demand__responses {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--color-text-secondary);
  font-size: 20rpx;
}

.demand__responses-icon {
  width: 30rpx;
  height: 30rpx;
  flex: 0 0 auto;
}

/* 关闭需求：白底描边次级按钮 */
.demand__close {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  margin: 0;
  padding: 0 var(--space-sm);
  box-sizing: border-box;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  background: var(--color-bg-card);
  color: var(--color-primary);
  font-size: 21rpx;
  font-weight: 650;
  line-height: 1;
}

.demand__close::after {
  border: none;
}

.demand-mine__more {
  padding: var(--space-md) 0;
  color: var(--color-text-placeholder);
  font-size: 20rpx;
  text-align: center;
}

/* 悬浮发布入口：避开自定义 TabBar */
.publish-fab {
  position: fixed;
  right: var(--space-md);
  bottom: calc(170rpx + env(safe-area-inset-bottom));
  z-index: 6;
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 88rpx;
  padding: 0 34rpx;
  border-radius: var(--radius-pill);
  background: var(--color-primary);
  box-shadow: 0 14rpx 32rpx rgba(180, 86, 110, 0.25);
  color: var(--color-text-inverse);
  font-size: 24rpx;
  font-weight: 650;
}

.publish-fab__icon {
  width: 30rpx;
  height: 30rpx;
  flex: 0 0 auto;
}
