<view class="screen screen--with-tab demand-mine">
  <view class="demand-mine__head">
    <text class="kicker">MY REQUESTS</text>
    <view class="page-heading">我的需求</view>
    <view class="demand-mine__sub">发布后等待同城化妆师响应，价格与履约线下确认</view>
    <view class="demand-mine__search" bindtap="onSearch">
      <image class="icon icon--sm" src="/assets/icons/search.svg" mode="aspectFit" />
      <text>找化妆师 · 按风格、档期、距离筛选</text>
      <image class="icon icon--xs" src="/assets/icons/chevron-right.svg" mode="aspectFit" />
    </view>
  </view>

  <view class="status-tabs-wrap">
    <view class="status-tabs">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="status-tabs__item {{activeTab === item.key ? 'status-tabs__item--active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onTabTap"
      >
        <text>{{item.label}}</text>
        <view
          wx:if="{{item.count > 0}}"
          class="status-tabs__count {{activeTab === item.key ? 'status-tabs__count--active' : ''}}"
        >{{item.count}}</view>
      </view>
    </view>

    <view class="status-tabs__context">
      <text class="status-tabs__context-label">{{activeTabLabel}}</text>
      <text class="status-tabs__context-total">{{total > 0 ? '共 ' + total + ' 条' : '暂无记录'}}</text>
    </view>
  </view>

  <view wx:if="{{error}}" class="card demand-mine__notice">
    <view class="card__title">{{error}}</view>
    <view class="card__desc">{{errorDesc}}</view>
    <button class="btn btn--primary btn--block demand-mine__notice-btn" bindtap="onPrimaryAction">
      {{primaryAction}}
    </button>
  </view>

  <view wx:elif="{{loading}}" class="empty">加载中…</view>

  <block wx:else>
    <view wx:if="{{list.length}}" class="demand-list">
      <view class="demand" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen">
        <view class="demand__head">
          <view class="demand__head-info">
            <view class="demand__date">{{item.dateText}}</view>
            <view class="demand__title">{{item.typeLabel}} · {{item.headcount}} 人</view>
          </view>
          <view class="tag tag--{{item.tone}}">{{item.statusLabel}}</view>
        </view>

        <view class="demand__meta">
          <view class="demand__meta-item">
            <image class="demand__meta-icon" src="/assets/icons/location-gray.svg" mode="aspectFit" />
            <text>{{item.city}} · {{item.district}}</text>
          </view>
          <view class="demand__meta-item">
            <image class="demand__meta-icon" src="/assets/icons/users-gray.svg" mode="aspectFit" />
            <text>{{item.headcount}} 人</text>
          </view>
          <text class="demand__budget">¥{{item.budgetText}}</text>
        </view>

        <view wx:if="{{item.styles.length}}" class="demand__styles">
          <text wx:for="{{item.styles}}" wx:for-item="style" wx:key="*this" class="demand__style">{{style}}</text>
        </view>

        <view wx:if="{{item.remark}}" class="demand__remark">{{item.remark}}</view>

        <view class="demand__foot">
          <view class="demand__responses">
            <image class="demand__responses-icon" src="/assets/icons/clock-warning.svg" mode="aspectFit" />
            <text>{{item.responseCount ? '已有 ' + item.responseCount + ' 位化妆师响应' : '等待化妆师响应'}}</text>
          </view>
          <button
            wx:if="{{item.canClose}}"
            class="demand__close"
            data-id="{{item.id}}"
            catchtap="onClose"
          >关闭需求</button>
        </view>
      </view>

      <view wx:if="{{loadingMore}}" class="demand-mine__more">加载中…</view>
      <view wx:elif="{{!hasMore && list.length}}" class="demand-mine__more">没有更多了</view>
    </view>

    <empty-state
      wx:else
      title="这里还没有需求"
      description="切换其他状态，或发布一条新的妆造需求"
      action="发布需求"
      bind:action="onPublish"
    />
  </block>

  <view wx:if="{{!error}}" class="publish-fab" bindtap="onPublish">
    <image class="publish-fab__icon" src="/assets/icons/plus.svg" mode="aspectFit" />
    <text>发布需求</text>
  </view>
</view>
