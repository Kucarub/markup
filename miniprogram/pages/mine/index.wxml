<view class="screen screen--with-tab mine-page">
  <view class="mine-hero">
    <view class="mine-heading">
      <text class="kicker">PROFILE</text>
      <view class="page-heading">我的</view>
    </view>

    <view class="mine-profile">
      <view class="avatar avatar--lg" bindtap="onAvatarTap">
        <image class="avatar__img" src="{{profile.avatar}}" mode="aspectFill" />
        <view wx:if="{{avatarUploading}}" class="avatar__mask">上传中…</view>
        <view wx:else class="avatar__edit">更换</view>
        <view wx:if="{{isArtist && credit}}" class="level-badge">{{credit.level}}</view>
      </view>
      <view class="mine-profile__copy">
        <view class="mine-name">{{profile.name}}</view>
        <view class="mine-desc">{{profile.city}} · {{isArtist ? '成长中的专业化妆师' : '正在寻找合适的化妆师'}}</view>
      </view>
      <view class="mine-edit" bindtap="onEditProfile">
        <image class="icon icon--xs" src="/assets/icons/chevron-right.svg" mode="aspectFit" />
      </view>
    </view>

    <view wx:if="{{isArtist}}" class="mine-progress">
      <view class="mine-progress__row">
        <text>资料完整度</text>
        <text class="mine-progress__value">{{profile.completeness}}%</text>
      </view>
      <view class="mine-progress__bar">
        <view class="mine-progress__fill" style="width: {{profile.completeness}}%"></view>
      </view>
    </view>
  </view>

  <view class="mine-content">
    <view wx:if="{{credit}}" class="credit-card" bindtap="onCreditTap">
      <view class="credit-card__score">
        <text class="credit-card__value">{{credit.score}}</text>
        <text class="credit-card__unit">信用分</text>
      </view>
      <view class="credit-card__copy">
        <view class="credit-card__level">{{credit.level}}</view>
        <view class="credit-card__desc">初始 0 分 · 完成 +2 · 取消 -5 · 满分 100</view>
      </view>
      <view class="credit-card__link">
        <text>服务记录</text>
        <image class="icon icon--xs" src="/assets/icons/chevron-right-light.svg" mode="aspectFit" />
      </view>
    </view>

    <view wx:if="{{stats.length}}" class="mine-stats">
      <view
        wx:for="{{stats}}"
        wx:key="key"
        class="mine-stat"
        data-key="{{item.key}}"
        bindtap="onStatTap"
      >
        <text class="mine-stat__value">{{item.value}}</text>
        <text class="mine-stat__label">{{item.label}}</text>
      </view>
    </view>

    <view class="menu-card">
      <view
        wx:for="{{menu}}"
        wx:key="key"
        class="menu-item {{item.separator ? 'menu-item--separator' : ''}}"
        hover-class="menu-item--hover"
        hover-stay-time="80"
        data-key="{{item.key}}"
        data-label="{{item.label}}"
        bindtap="onMenuTap"
      >
        <view class="menu-icon">
          <image class="icon icon--sm" src="/assets/icons/{{item.icon}}.svg" mode="aspectFit" />
        </view>
        <text class="menu-label">{{item.label}}</text>
        <text wx:if="{{item.badge}}" class="menu-badge">{{item.badge}}</text>
        <text wx:if="{{item.note}}" class="menu-note">{{item.note}}</text>
        <image class="icon icon--xs menu-arrow" src="/assets/icons/chevron-right.svg" mode="aspectFit" />
      </view>

      <!-- 分享行与普通菜单行同构，用透明原生 share 按钮覆盖整行 -->
      <view class="menu-item menu-item--share">
        <view class="menu-icon">
          <image class="icon icon--sm" src="/assets/icons/send.svg" mode="aspectFit" />
        </view>
        <text class="menu-label">分享给好友</text>
        <image class="icon icon--xs menu-arrow" src="/assets/icons/chevron-right.svg" mode="aspectFit" />
        <button
          class="menu-item__share-btn"
          open-type="share"
          hover-class="menu-item--hover"
          hover-stay-time="80"
        ></button>
      </view>
    </view>

    <view wx:if="{{isArtist}}" class="growth-note">
      <image class="icon icon--md growth-note__icon" src="/assets/icons/heart.svg" mode="aspectFit" />
      <view class="growth-note__copy">
        <text class="growth-note__title">每一次认真练习，都在积累专业</text>
        <text class="growth-note__desc">继续完善作品，你会被更多客户看到</text>
      </view>
    </view>

    <view class="logout-btn" hover-class="logout-btn--hover" hover-stay-time="80" bindtap="onLogout">
      <image class="icon icon--sm" src="/assets/icons/logout-brand.svg" mode="aspectFit" />
      <text>退出登录</text>
    </view>
  </view>
</view>
