.mine-page {
  background: var(--color-bg-page);
}

.mine-hero {
  padding-bottom: 40rpx;
  background: radial-gradient(circle at 88% 15%, rgba(180, 86, 110, 0.12), transparent 30%),
    linear-gradient(145deg, var(--color-primary-soft), #ffffff);
}

.mine-heading {
  padding: 24rpx 36rpx 6rpx;
}

.mine-profile {
  display: flex;
  align-items: center;
  gap: 26rpx;
  padding: 28rpx 36rpx 26rpx;
}

.mine-profile__copy {
  flex: 1;
  min-width: 0;
}

.mine-name {
  margin-bottom: 8rpx;
  font-size: 38rpx;
  font-weight: 650;
}

.mine-desc {
  color: var(--color-text-secondary);
  font-size: 21rpx;
}

.mine-edit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
}

.mine-progress {
  padding: 0 36rpx;
}

.mine-progress__row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
  color: var(--color-text-secondary);
  font-size: 19rpx;
}

.mine-progress__value {
  color: var(--color-primary);
  font-weight: 600;
}

.mine-progress__bar {
  height: 10rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #edd6dc;
}

.mine-progress__fill {
  height: 100%;
  border-radius: inherit;
  background: var(--color-primary);
}

.mine-content {
  padding: 0 28rpx 40rpx;
}

.mine-stats {
  display: flex;
  margin: 24rpx 0;
  padding: 30rpx 0;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
  box-shadow: var(--shadow-card);
}

.mine-stat {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 8rpx;
}

.mine-stat:not(:last-child)::after {
  content: '';
  position: absolute;
  top: 6rpx;
  right: 0;
  width: 2rpx;
  height: 64rpx;
  background: var(--color-border);
}

.mine-stat__value {
  font-size: 36rpx;
  font-weight: 650;
}

.mine-stat__label {
  color: var(--color-text-secondary);
  font-size: 19rpx;
}

.menu-card {
  overflow: hidden;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
  box-shadow: var(--shadow-card);
}

.menu-item {
  position: relative;
  display: flex;
  align-items: center;
  height: 108rpx;
  padding: 0 28rpx;
}

.menu-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 28rpx;
  bottom: 0;
  left: 96rpx;
  height: 2rpx;
  background: var(--color-divider);
}

.menu-item--separator {
  height: 124rpx;
  margin-top: 16rpx;
  border-top: 16rpx solid var(--color-bg-page);
}

.menu-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  margin-right: 16rpx;
}

.menu-label {
  flex: 1;
  color: var(--color-text-regular);
  font-size: 26rpx;
}

.menu-badge {
  min-width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: var(--color-danger);
  color: var(--color-text-inverse);
  font-size: 18rpx;
}

.menu-note {
  margin-right: 14rpx;
  color: var(--color-text-placeholder);
  font-size: 18rpx;
}

.growth-note {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.growth-note__icon {
  flex: 0 0 auto;
  margin-top: 2rpx;
}

.growth-note__copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.growth-note__title {
  color: var(--color-text-regular);
  font-size: 22rpx;
  font-weight: 600;
}

.growth-note__desc {
  color: var(--color-text-secondary);
  font-size: 19rpx;
}

.logout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  margin-top: 24rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}
