/* 入驻状态三态页：待审核 / 已通过 / 被驳回（E4-03） */
.page {
  padding-top: 120rpx;
}

.card {
  padding: 56rpx 40rpx;
  text-align: center;
}

.card + .card {
  margin-top: 24rpx;
}

.card__title {
  font-size: 40rpx;
  font-weight: 650;
}

.card__desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
}

.card__desc + .card__desc {
  margin-top: 8rpx;
}

.card .btn {
  margin-top: 48rpx;
  height: 96rpx;
  border-radius: 18rpx;
  font-size: 30rpx;
}
