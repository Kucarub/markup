/* 评价提交（E10-06） */
.review {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.review__notice {
  margin: var(--space-md);
}

.review__notice-btn {
  margin-top: var(--space-md);
}

.review__hero {
  padding: var(--space-md);
  background: linear-gradient(135deg, var(--color-primary-tint), var(--color-bg-card));
}

.review__sub {
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.review__body {
  padding: var(--space-md);
}

.review__target-name {
  font-size: 30rpx;
  font-weight: 650;
}

.review__target-meta {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.review__label {
  margin-bottom: 18rpx;
  font-size: 26rpx;
  font-weight: 650;
}

.review__optional {
  color: var(--color-text-placeholder);
  font-size: 22rpx;
  font-weight: 400;
}

/* ---------- 星级 ---------- */
.review__stars {
  display: flex;
  gap: 18rpx;
}

.review__star {
  color: var(--color-border);
  font-size: 60rpx;
  line-height: 1;
}

.review__star--on {
  color: #f0a500;
}

.review__rating-text {
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

/* ---------- 标签 ---------- */
.review__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.review__tag {
  padding: 12rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-pill);
  background: var(--color-primary-soft);
  color: var(--color-text-regular);
  font-size: 24rpx;
}

.review__tag--on {
  border-color: var(--color-primary);
  background: var(--color-primary-tint);
  color: var(--color-primary);
  font-weight: 600;
}

/* ---------- 文本域 ---------- */
.review__textarea {
  width: 100%;
  height: 200rpx;
  padding: var(--space-sm) var(--space-md);
  box-sizing: border-box;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-primary-soft);
  color: var(--color-text-primary);
  font-size: var(--font-size-sm);
  line-height: 1.6;
}

.review__placeholder {
  color: var(--color-text-placeholder);
}

.review__count {
  margin-top: 10rpx;
  text-align: right;
  color: var(--color-text-placeholder);
  font-size: 22rpx;
}

/* ---------- 提交 ---------- */
.review__submit {
  margin-top: var(--space-lg);
}

.review__tip {
  margin-top: var(--space-sm);
  text-align: center;
  color: var(--color-text-placeholder);
  font-size: 22rpx;
  line-height: 1.6;
}
