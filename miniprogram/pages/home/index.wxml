<view class="screen screen--with-tab">
  <view class="home-content">
    <view class="home-toolbar">
      <view class="city" bindtap="onCityTap">
        <image class="icon icon--xs" src="/assets/icons/location.svg" mode="aspectFit" />
        <text>{{profile.city}}</text>
        <image class="icon icon--xs" src="/assets/icons/chevron-down.svg" mode="aspectFit" />
      </view>
      <view class="bell" bindtap="onBellTap">
        <image class="icon icon--md" src="/assets/icons/bell.svg" mode="aspectFit" />
        <view class="bell__dot"></view>
      </view>
    </view>

    <!-- 化妆师工作台 -->
    <block wx:if="{{role === 'artist'}}">
      <view class="profile-card">
        <view class="avatar avatar--lg">
          <image class="avatar__img" src="{{profile.avatar}}" mode="aspectFill" />
          <view class="level-badge">{{profile.level}}</view>
        </view>
        <view class="profile-copy">
          <view class="profile-name">{{profile.name}}</view>
          <view class="profile-desc">{{profile.subtitle}}</view>
          <view class="completion">
            <view class="completion__bar">
              <view class="completion__fill" style="width: {{profile.completeness}}%"></view>
            </view>
            <text>资料 {{profile.completeness}}%</text>
          </view>
          <view class="btn btn--secondary btn--sm profile-edit" bindtap="onEditProfile">完善资料</view>
        </view>
      </view>

      <view class="stats-strip">
        <view class="stat" wx:for="{{stats}}" wx:key="label">
          <text class="stat__value">{{item.value}}</text>
          <text class="stat__label">{{item.label}}</text>
        </view>
      </view>

      <view class="section-block">
        <view class="section-heading">
          <view>
            <text class="kicker">AVAILABILITY</text>
            <view class="section-title">近期档期</view>
          </view>
          <view class="section-link" bindtap="onEditSchedule">
            <text>设置</text>
            <image class="icon icon--xs" src="/assets/icons/chevron-right.svg" mode="aspectFit" />
          </view>
        </view>

        <view class="schedule-strip">
          <view
            wx:for="{{schedule}}"
            wx:key="day"
            class="schedule-day {{item.state === 'today' ? 'schedule-day--today' : ''}} {{item.state === 'booked' ? 'schedule-day--booked' : ''}}"
            data-state="{{item.state}}"
            data-day="{{item.day}}"
            bindtap="onDayTap"
          >
            <text class="schedule-day__week">{{item.weekday}}</text>
            <text class="schedule-day__day">{{item.day}}</text>
            <view wx:if="{{item.state === 'available'}}" class="schedule-day__dot"></view>
          </view>
        </view>
      </view>

      <view class="section-block">
        <view class="section-heading">
          <view>
            <text class="kicker">FOR YOU</text>
            <view class="section-title">适合你的需求</view>
          </view>
          <view class="section-link" bindtap="goHall">
            <text>全部</text>
            <image class="icon icon--xs" src="/assets/icons/chevron-right.svg" mode="aspectFit" />
          </view>
        </view>

        <view class="card-list">
          <view class="card-item" wx:for="{{recommended}}" wx:key="id">
            <demand-card demand="{{item}}" compact bind:open="onDemandOpen" />
          </view>
        </view>
      </view>
    </block>

    <block wx:elif="{{role === 'customer'}}">
      <!-- 客户工作台 -->
      <view class="customer-hero">
        <text class="kicker">WELCOME</text>
        <view class="customer-hero__title">找到适合你的化妆师</view>
        <view class="customer-hero__desc">发布妆造需求，让同城化妆师主动联系你，也可以自己挑选。</view>
        <view class="customer-actions">
          <view class="btn btn--primary" bindtap="goPublishDemand">发布需求</view>
          <view class="btn btn--secondary" bindtap="goSearchArtists">找化妆师</view>
        </view>
      </view>

      <view class="section-block">
        <view class="section-heading">
          <view>
            <text class="kicker">MY DEMANDS</text>
            <view class="section-title">我的需求</view>
          </view>
          <view class="section-link" bindtap="goMyDemands">
            <text>全部</text>
            <image class="icon icon--xs" src="/assets/icons/chevron-right.svg" mode="aspectFit" />
          </view>
        </view>

        <view wx:if="{{myDemandsLoading}}" class="empty">加载中…</view>
        <view wx:elif="{{myDemandsError}}" class="empty">{{myDemandsError}}</view>
        <view wx:elif="{{!myDemands.length}}" class="customer-empty">
          <text>还没有发布需求</text>
          <view class="btn btn--ghost btn--sm" bindtap="goPublishDemand">发布第一个需求</view>
        </view>
        <view wx:else class="card-list">
          <view
            wx:for="{{myDemands}}"
            wx:key="id"
            class="demand-row"
            hover-class="demand-row--hover"
            hover-stay-time="80"
            data-id="{{item.id}}"
            bindtap="onMyDemandTap"
          >
            <view class="demand-row__head">
              <text class="demand-row__title">{{item.typeLabel}}</text>
              <text class="tag tag--{{item.tone}}">{{item.statusLabel}}</text>
            </view>
            <view class="demand-row__meta">
              {{item.dateText}} · {{item.headcount}} 位 · {{item.place}}
            </view>
            <view class="demand-row__foot">
              <text wx:if="{{item.budgetText}}" class="demand-row__budget">预算 ¥{{item.budgetText}}</text>
              <text class="demand-row__responses">{{item.responseText}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="section-block">
        <view class="section-heading">
          <view>
            <text class="kicker">ARTISTS</text>
            <view class="section-title">为你推荐</view>
          </view>
          <view class="section-link" bindtap="goSearchArtists">
            <text>全部</text>
            <image class="icon icon--xs" src="/assets/icons/chevron-right.svg" mode="aspectFit" />
          </view>
        </view>

        <view wx:if="{{artistsLoading}}" class="empty">加载中…</view>
        <view wx:elif="{{artistsError}}" class="empty">{{artistsError}}</view>
        <view wx:elif="{{!artists.length}}" class="customer-empty">暂时没有推荐的化妆师</view>
        <view wx:else class="card-list">
          <view
            wx:for="{{artists}}"
            wx:key="id"
            class="artist-row"
            hover-class="artist-row--hover"
            hover-stay-time="80"
            data-id="{{item.id}}"
            bindtap="onArtistTap"
          >
            <image wx:if="{{item.cover}}" class="artist-row__cover" src="{{item.cover}}" mode="aspectFill" />
            <view wx:else class="artist-row__cover artist-row__cover--empty">暂无作品图</view>
            <view class="artist-row__body">
              <view class="artist-row__head">
                <text class="artist-row__name">{{item.name}}</text>
                <text class="artist-row__works">{{item.worksTotal}} 件作品</text>
              </view>
              <view class="artist-row__meta">{{item.place}} · {{item.years}} 年经验</view>
              <view wx:if="{{item.styles.length}}" class="artist-row__tags">
                <text wx:for="{{item.styles}}" wx:for-item="style" wx:key="*this" class="tag tag--neutral">
                  {{style}}
                </text>
              </view>
              <view class="artist-row__avail">{{item.availText}}</view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
