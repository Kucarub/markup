<view class="page">
  <view class="card">
    <view class="row row--between">
      <view>
        <view class="card__title">账号与登录</view>
        <view class="card__desc">微信登录与手机号绑定已接入（E3），可在此切换身份或退出登录</view>
      </view>
      <button class="btn btn--sm btn--primary" bindtap="goRole">设置角色</button>
    </view>
  </view>

  <view class="card list">
    <view class="list__item" bindtap="goRole">
      <text>角色与入驻</text>
      <text class="muted">›</text>
    </view>
    <view class="list__item" bindtap="goTokens">
      <text>设计 token 示例</text>
      <text class="muted">›</text>
    </view>
    <view class="list__item">
      <text>用户协议与隐私政策</text>
      <text class="muted">E1-08</text>
    </view>
    <view class="list__item">
      <text>版本</text>
      <text class="muted">{{version}}</text>
    </view>
  </view>

  <button class="btn btn--block logout" bindtap="handleLogout">退出登录</button>
</view>
