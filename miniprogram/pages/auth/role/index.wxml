<view class="page">
  <view class="page-title">选择你的身份</view>
  <view class="page-subtitle">角色提交后由服务端校验，入驻资料在 E4 / E7 补齐</view>

  <view
    class="card role"
    wx:for="{{roles}}"
    wx:key="key"
    data-role="{{item.key}}"
    bindtap="selectRole"
  >
    <view class="card__title">{{item.title}}</view>
    <view class="card__desc">{{item.desc}}</view>
  </view>
</view>
