.portfolio-top {
  border-bottom: 2rpx solid var(--color-border);
  background: var(--color-bg-card);
}

.page-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx 20rpx;
}

.create-btn {
  height: 68rpx;
  padding: 0 22rpx;
  font-size: 22rpx;
}

.segment-control {
  white-space: nowrap;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.segment {
  position: relative;
  display: inline-block;
  padding: 0 26rpx 24rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.segment::after {
  content: '';
  position: absolute;
  left: 26rpx;
  right: 26rpx;
  bottom: 0;
  height: 4rpx;
  border-radius: 999rpx;
  background: transparent;
}

.segment--active {
  color: var(--color-text-primary);
  font-weight: 650;
}

.segment--active::after {
  background: var(--color-primary);
}

.portfolio-content {
  padding: 28rpx 32rpx 40rpx;
}

.portfolio-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  color: var(--color-text-secondary);
  font-size: 20rpx;
}

.portfolio-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.portfolio-cell {
  width: calc(50% - 12rpx);
  margin-bottom: 24rpx;
}
