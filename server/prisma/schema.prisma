// 数据模型见任务拆解 V1.1 附录 C。
// 表名与字段统一映射为 snake_case，模型/字段保持 camelCase 便于 TS 侧使用。
// 状态类字段使用 VarChar + 注释约定取值，校验交给 zod（避免 MySQL ENUM 迭代时频繁迁移）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// 微信用户与登录态（M/C 共用）
model UserAuth {
  id          Int       @id @default(autoincrement())
  openid      String    @unique @db.VarChar(64)
  unionid     String?   @db.VarChar(64)
  /// AES-256-GCM 密文，禁止明文落库
  phoneCipher String?   @map("phone_cipher") @db.VarChar(255)
  /// artist | customer，未选角色时为 null
  role        String?   @db.VarChar(16)
  /// active | disabled
  status      String    @default("active") @db.VarChar(16)
  nickname    String?   @db.VarChar(64)
  avatarUrl   String?   @map("avatar_url") @db.VarChar(512)
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  artist        Artist?
  customer      Customer?
  notifications Notification[]
  reports       Report[]

  @@map("user_auth")
}

/// 化妆师入驻资料
model Artist {
  id           Int       @id @default(autoincrement())
  userId       Int       @unique @map("user_id")
  name         String    @db.VarChar(32)
  city         String    @db.VarChar(32)
  district     String?   @db.VarChar(32)
  years        Int       @default(0)
  /// 擅长风格 code 数组
  styles       Json?
  intro        String?   @db.Text
  /// AES-256-GCM 密文
  idCardCipher String?   @map("id_card_cipher") @db.VarChar(255)
  /// pending | approved | rejected | disabled
  status       String    @default("pending") @db.VarChar(16)
  rejectReason String?   @map("reject_reason") @db.VarChar(255)
  lat          Float?
  lng          Float?
  auditAt      DateTime? @map("audit_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user        UserAuth          @relation(fields: [userId], references: [id])
  portfolios  ArtistPortfolio[]
  schedules   ArtistSchedule[]
  visits      ArtistVisit[]
  responses   DemandResponse[]
  targetedDemands Demand[]    @relation("DemandTarget")
  serviceOrders ServiceOrder[]

  @@index([status, city])
  @@map("artist")
}

/// 化妆师作品
model ArtistPortfolio {
  id           Int      @id @default(autoincrement())
  artistId     Int      @map("artist_id")
  /// image | video
  type         String   @default("image") @db.VarChar(16)
  url          String   @db.VarChar(1024)
  coverUrl     String?  @map("cover_url") @db.VarChar(1024)
  /// 防盗水印版本（E14-02）
  watermarkUrl String?  @map("watermark_url") @db.VarChar(1024)
  title        String   @db.VarChar(64)
  styles       Json?
  sort         Int      @default(0)
  /// pending | online | offline | rejected
  status       String   @default("pending") @db.VarChar(16)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId, sort])
  @@map("artist_portfolio")
}

/// 档期（available / booked / rest）
model ArtistSchedule {
  id        Int      @id @default(autoincrement())
  artistId  Int      @map("artist_id")
  date      DateTime @db.Date
  /// available | booked | rest
  state     String   @default("available") @db.VarChar(16)
  /// 被哪笔订单占用（booked 时回填）
  orderId   Int?     @map("order_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, date], map: "uniq_artist_date")
  @@index([date, state])
  @@map("artist_schedule")
}

/// 主页访问 UV（同设备 + 同自然日仅记一条，E5-06）
model ArtistVisit {
  id         Int      @id @default(autoincrement())
  artistId   Int      @map("artist_id")
  /// 设备标识的 SHA-256，不落明文设备号
  deviceHash String   @map("device_hash") @db.VarChar(64)
  visitDate  DateTime @map("visit_date") @db.Date
  createdAt  DateTime @default(now()) @map("created_at")

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, deviceHash, visitDate], map: "uniq_artist_device_day")
  @@index([visitDate])
  @@map("artist_visit")
}

/// 客户资料（无资质审核：选择客户角色即自动创建）
model Customer {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  nickname  String?  @db.VarChar(32)
  city      String?  @db.VarChar(32)
  district  String?  @db.VarChar(32)
  /// active | disabled
  status    String   @default("active") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    UserAuth @relation(fields: [userId], references: [id])
  demands Demand[]
  serviceOrders ServiceOrder[]

  @@index([city])
  @@map("customer")
}

/// 客户需求（同城撮合起点；定向预约时 target_artist_id 非空）
model Demand {
  id             Int      @id @default(autoincrement())
  customerId     Int      @map("customer_id")
  targetArtistId Int?     @map("target_artist_id")
  city           String   @db.VarChar(32)
  district       String   @db.VarChar(32)
  serviceDate    DateTime @map("service_date") @db.Date
  /// bridal | daily | event | photo
  serviceType    String   @map("service_type") @db.VarChar(16)
  headcount      Int      @default(1)
  budgetMin      Int      @map("budget_min")
  budgetMax      Int      @map("budget_max")
  /// 风格偏好 code 数组
  stylePrefs     Json?    @map("style_prefs")
  remark         String?  @db.Text
  /// pending | selected | closed（「已响应」由响应数派生，不单独落库）
  status         String   @default("pending") @db.VarChar(16)
  /// customer | ops（运营代发布标记）
  source         String   @default("customer") @db.VarChar(8)
  /// 服务日次日零点，过期后不再进入需求大厅
  expireAt       DateTime? @map("expire_at")
  closedAt       DateTime? @map("closed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  targetArtist Artist?          @relation("DemandTarget", fields: [targetArtistId], references: [id])
  responses    DemandResponse[]
  serviceOrder ServiceOrder?

  @@index([status, city, serviceDate])
  @@index([customerId, status])
  @@map("demand")
}

/// 化妆师对需求的报名响应（E8-03 写入；E7 仅用于统计响应数）
model DemandResponse {
  id        Int      @id @default(autoincrement())
  demandId  Int      @map("demand_id")
  artistId  Int      @map("artist_id")
  note      String?  @db.VarChar(255)
  /// pending | selected | rejected | withdrawn
  status    String   @default("pending") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  demand Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id])

  @@unique([demandId, artistId], map: "uniq_demand_artist")
  @@index([artistId, status])
  @@map("demand_response")
}

/// 服务记录（E8-04 择一确认时生成；状态机在 E10-01 扩展）
/// 不含成交金额，仅记录服务日期、区域、类型、人数与双方确认状态
model ServiceOrder {
  id          Int      @id @default(autoincrement())
  demandId    Int      @unique @map("demand_id")
  customerId  Int      @map("customer_id")
  artistId    Int      @map("artist_id")
  serviceDate DateTime @map("service_date") @db.Date
  /// bridal | daily | event | photo
  serviceType String   @map("service_type") @db.VarChar(16)
  headcount   Int      @default(1)
  city        String   @db.VarChar(32)
  district    String   @db.VarChar(32)
  remark      String?  @db.Text
  /// pending | confirmed | finished | cancelled
  status      String   @default("pending") @db.VarChar(16)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  demand   Demand   @relation(fields: [demandId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])
  artist   Artist   @relation(fields: [artistId], references: [id])

  @@index([artistId, status])
  @@index([customerId, status])
  @@map("service_order")
}

/// 审核操作流水
model AuditLog {
  id         Int      @id @default(autoincrement())
  /// artist | portfolio | report
  targetType String   @map("target_type") @db.VarChar(16)
  targetId   Int      @map("target_id")
  /// approve | reject | offline | restore
  action     String   @db.VarChar(16)
  reason     String?  @db.VarChar(255)
  operatorId Int      @map("operator_id")
  createdAt  DateTime @default(now()) @map("created_at")

  operator AdminUser @relation(fields: [operatorId], references: [id])

  @@index([targetType, targetId])
  @@map("audit_log")
}

/// 后台账号
model AdminUser {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(32)
  passwordHash String    @map("password_hash") @db.VarChar(128)
  /// super | admin | auditor
  role         String    @default("admin") @db.VarChar(16)
  /// active | disabled
  status       String    @default("active") @db.VarChar(16)
  failCount    Int       @default(0) @map("fail_count")
  lockedUntil  DateTime? @map("locked_until")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  auditLogs AuditLog[]

  @@map("admin_user")
}

/// 订阅消息发送记录
model Notification {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  /// demand | response | report_result | ...
  type       String    @db.VarChar(32)
  payload    Json?
  /// pending | sent | failed
  status     String    @default("pending") @db.VarChar(16)
  sentAt     DateTime? @map("sent_at")
  failReason String?   @map("fail_reason") @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at")

  user UserAuth @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notification")
}

/// 举报
model Report {
  id             Int      @id @default(autoincrement())
  /// portfolio | artist | user
  targetType     String   @map("target_type") @db.VarChar(16)
  targetId       Int      @map("target_id")
  reason         String   @db.VarChar(255)
  reporterId     Int      @map("reporter_id")
  /// 按天去重：同一用户同一目标每天只能举报一次
  date           DateTime @db.Date
  /// pending | handled | rejected
  status         String   @default("pending") @db.VarChar(16)
  handleOperator Int?     @map("handle_operator")
  handleResult   String?  @map("handle_result") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  reporter UserAuth @relation(fields: [reporterId], references: [id])

  @@unique([reporterId, targetType, targetId, date], map: "uniq_reporter_target_date")
  @@index([status])
  @@map("report")
}

/// 埋点事件（漏斗与看板数据源）
model EventLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  /// artist | customer | admin
  role      String?  @db.VarChar(16)
  event     String   @db.VarChar(64)
  props     Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([event, createdAt])
  @@map("event_log")
}

/// 每日汇总指标
model StatsDaily {
  id             Int      @id @default(autoincrement())
  date           DateTime @unique @db.Date
  registrations  Int      @default(0)
  artistPageUv   Int      @default(0) @map("artist_page_uv")
  invitations    Int      @default(0)
  matches        Int      @default(0)
  matchRate      Float    @default(0) @map("match_rate")
  retentionD7    Float    @default(0) @map("retention_d7")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("stats_daily")
}

/// 对象存储文件记录（私有桶；访问必须走签名 URL）
model FileObject {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  /// portfolio | avatar | license | id_card | report
  scene     String   @db.VarChar(16)
  bucket    String   @db.VarChar(64)
  objectKey String   @unique @map("object_key") @db.VarChar(180)
  /// 落库路径或 CDN 地址，私有桶不直接对外
  url       String?  @db.VarChar(1024)
  size      Int      @default(0)
  mimeType  String   @map("mime_type") @db.VarChar(64)
  /// pending | uploaded | deleted
  status    String   @default("pending") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("file_object")
}

/// 字典（风格 / 城市等），E2-02 种子写入
model DictItem {
  id        Int      @id @default(autoincrement())
  /// style | city | service_type
  type      String   @db.VarChar(32)
  code      String   @db.VarChar(64)
  label     String   @db.VarChar(64)
  sort      Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([type, code])
  @@index([type, sort])
  @@map("dict_item")
}
