# 复制为 .env 后按本地环境修改即可启动（cp .env.example .env）

# 运行环境：development | test | production
NODE_ENV=development

# 服务端口
PORT=3000

# MySQL 5.7 连接串（E2-01 起由 Prisma 迁移管理表结构）
# 生产建议追加 ?connection_limit=5&pool_timeout=10，避免 2G 机器被连接池吃满
DATABASE_URL="mysql://root:root@127.0.0.1:3306/wechat_markup"

# Redis（E3 起用于 token / 缓存）
REDIS_URL="redis://127.0.0.1:6379/0"

# JWT 密钥，生产环境务必替换为 >= 32 位随机串
JWT_SECRET="dev-only-secret-change-me-0123456789"
JWT_EXPIRES_IN=7d
# refresh token 独立密钥（留空则复用 JWT_SECRET）
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# 允许跨域的来源，多个用英文逗号分隔；* 表示不限制（仅开发环境）
CORS_ORIGINS=*

# 微信小程序（E1-08 申请后填入真实值）
WX_APPID=
WX_SECRET=
WX_TEMPLATE_INVITATION=
WX_TEMPLATE_RESULT=

# 对象存储（E2-05）：本地私有桶目录
# 四个 OSS_* 变量齐全时自动切换为阿里云 OSS：读取返回 OSS 签名地址，上传经服务器转发
STORAGE_DIR=storage
STORAGE_SECRET=
MAX_UPLOAD_MB=5
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 敏感字段 AES 密钥，32 位十六进制（E2-06）：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AES_KEY=
